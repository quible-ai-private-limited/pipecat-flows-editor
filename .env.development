# Origins allowed to embed the editor at /editor?embed=1 (comma-separated, no trailing slash).
# Used by `next dev`. Builds set it in the hosting environment (Amplify) instead.
# http://localhost:5173 is the Dashboard; http://localhost:5500 is tools/embed-test.
NEXT_PUBLIC_EMBED_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5500
